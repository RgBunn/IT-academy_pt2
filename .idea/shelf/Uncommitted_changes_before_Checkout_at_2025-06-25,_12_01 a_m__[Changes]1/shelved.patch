<+>@import url(\"https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap\");\n\n:root {\n    --black: #232323;\n    --red: #f65261;\n    --white: #ffffff;\n    --dark-gray: #424242;\n    --light-gray: #555555;\n    --ff-montserrat: \"Montserrat\", sans-serif;\n}\n* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\nbody {\n    background-color: var(--dark-gray);\n    font-family: var(--ff-montserrat);\n    color: var(--white);\n    font-size: 16px;\n    height: 100vh;\n}\n\n/* logo */\n.header__logo {\n    color: var(--red);\n    font-weight: 500;\n    font-size: 20px;\n}\n.header__logo span {\n    font-weight: 900;\n}\n.app-container {\n    background-color: var(--black);\n}\n.app-container {\n    width: 1200px;\n    padding: 50px;\n}\nheader {\n    /* border: 2px solid red; */\n    overflow: hidden;\n    height: 400px;\n    position: relative;\n}\n\n.header__background {\n    background-image: url(../../public/images/header-background.webp);\n    background-repeat: no-repeat;\n    background-size: cover;\n    background-position: center;\n    width: 100%;\n    height: 100%;\n    position: relative;\n    z-index: 0;\n}\n.header__overlay {\n    background: rgba(0, 0, 0, 0.5);\n    backdrop-filter: blur(5px);\n    position: absolute;\n    width: 100%;\n    height: 100%;\n}\n.header__wrapper {\n    /* border: 5px solid green; */\n    position: absolute;\n    z-index: 2;\n    top: 0;\n    right: 0;\n    bottom: 0;\n    left: 0;\n}\n.header__top {\n    display: flex;\n    justify-content: space-between;\n    padding: 20px 60px;\n}\n.header__main {\n    padding: 40px 120px;\n}\n.header__title {\n    font-weight: 300;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n}\n.header__search-bar {\n    display: flex;\n    gap: 20px;\n    width: 100%;\n    margin-top: 20px;\n}\n.header__search-bar input {\n    background-color: hsla(0, 0%, 26%, 0.5);\n    border: none;\n    padding: 14px;\n    width: 100%;\n    outline: 0;\n    color: var(--white);\n}\n.header__search-bar input:focus {\n    border: 1px solid hsla(355, 90%, 64%, 0.5);\n}\n/* navigation */\n.movie-toolbar {\n    /* border: 1px solid green; */\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin: 20px 0;\n    position: relative;\n    padding-bottom: 20px;\n}\n.movie-toolbar__list {\n    /* border: 1px solid pink; */\n    display: flex;\n    gap: 15px;\n}\n.movie-toolbar__list li {\n    list-style-type: none;\n}\n.movie-toolbar__sort {\n    /* border: 1px solid yellowgreen; */\n}\n.movie-toolbar__list li a {\n    text-decoration: none;\n    text-transform: uppercase;\n    color: var(--white);\n    font-weight: 500;\n}\n/* active tab line */\n.movie-toolbar::after {\n    content: \"\";\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    height: 2px;\n    background-color: var(--light-gray);\n    z-index: 0;\n}\n.movie-toolbar__item {\n    position: relative;\n    padding-bottom: 2px;\n    z-index: 1;\n}\n\n.movie-toolbar__item::after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    bottom: -2px;\n    height: 3px;\n    background: var(--red);\n    transform: scaleX(0);\n    transform-origin: left;\n    transition: transform 0.5s ease;\n}\n\n.movie-toolbar__item.active::after {\n    transform: scaleX(1);\n}\n.movie-toolbar__filters {\n    position: relative;\n    z-index: 1;\n}\n/*  */\n.movie-toolbar__item {\n    position: relative;\n    padding-bottom: 2px;\n    z-index: 1;\n}\n.movie-toolbar__item::after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    bottom: -20px;\n    width: 100%;\n    height: 3px;\n    background: var(--red);\n    transform: scaleX(0);\n    transform-origin: left;\n    transition: transform 0.5s ease;\n}\n.movie-toolbar__item.active::after {\n    transform: scaleX(1);\n}\n/*  */\n.movie-toolbar__sort {\n    display: flex;\n    gap: 1rem;\n}\n.movie-toolbar__label {\n    text-transform: uppercase;\n    color: hsla(0, 0%, 100%, 0.5);\n}\n.movie-toolbar__select {\n    appearance: none;\n    background: url(\"../../public/images/arrow-down.svg\") no-repeat right 20px center;\n    background-size: 1rem;\n    background-size: 1rem;\n    padding-right: 3rem;\n    border: none;\n    text-transform: uppercase;\n    color: var(--white);\n    font-size: 16px;\n}\nmain {\n    padding: 0 20px;\n}\n.movie-gallery__count {\n    font-size: 20px;\n    margin-bottom: 20px;\n}\n.movie-gallery__amount {\n    font-weight: 600;\n}\n.movie-gallery__list {\n    /* border: 2px solid orange; */\n    display: flex;\n    flex-wrap: wrap;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 40px;\n    padding-bottom: 50px;\n}\n.movie-card {\n    /* border: 2px solid yellow; */\n    width: 325px;\n    position: relative;\n}\n.movie__card .movie-card__poster {\n    height: 455px;\n    overflow: hidden;\n    position: relative;\n}\n.movie-card__poster img {\n    width: 100%;\n    object-fit: cover;\n}\n.movie-card__details {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-top: 20px;\n    margin-bottom: 10px;\n    opacity: 0.7;\n}\n.movie-card__title {\n    font-weight: 500;\n    font-size: 18px;\n    color: var(--white);\n}\n.movie-card__year {\n    border: 1px solid hsla(0, 0%, 100%, 0.3);\n    border-radius: 3px;\n    padding: 4px 8px;\n    font-size: 14px;\n}\n.movie-card__genre {\n    opacity: 0.5;\n}\n/* movie menu */\n.movie-card__menu {\n    width: 190px;\n    background-color: var(--black);\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    display: flex;\n    flex-direction: column;\n\n    /* color: var(--white); */\n}\n.movie-card__menu ul li {\n    list-style-type: none;\n    width: 100%;\n}\n.movie-card__menu ul li a {\n    display: block;\n    color: var(--white);\n    text-decoration: none;\n    width: 100%;\n    padding: 10px 20px;\n    margin-bottom: 10px;\n}\n.movie-card__menu ul li a:hover {\n    background-color: var(--red);\n}\n/* buttons */\n.btn {\n    text-transform: uppercase;\n    border-radius: 4px;\n    padding: 10px 15px;\n    border: none;\n    transition: background-color 0.3s ease;\n}\n.btn:hover {\n    cursor: pointer;\n}\n.btn-red {\n    color: var(--white);\n    background-color: var(--red);\n}\n.btn-outline {\n    background-color: transparent;\n    color: var(--red);\n    border: 1px solid var(--red);\n}\n.btn-outline:hover {\n    color: black;\n    background-color: var(--red);\n    box-shadow: 0 0 0 2px var(--red), 0 0 8px var(--red);\n}\n.btn-reset,\n.btn-submit {\n    padding: 10px 30px;\n}\n.btn-add {\n    color: var(--red);\n    background-color: hsla(0, 0%, 33%, 0.6);\n    border: none;\n    font-weight: 500;\n    transition: background-color 0.3s ease;\n}\n.btn-add:hover {\n    background-color: hsla(0, 0%, 43%, 0.7);\n}\n.btn-search {\n    padding: 14px 50px;\n    font-weight: 500;\n}\n.btn-search-icon {\n    background-image: url(../../public/images/search.svg);\n    background-size: 50%;\n    background-repeat: no-repeat;\n    background-position: center;\n    width: 3rem;\n    height: 3rem;\n    background-color: transparent;\n    border: none;\n    margin-left: auto;\n    cursor: pointer;\n}\n.btn-red:hover {\n    background-color: #ff6f78;\n}\n.btn-movie-menu {\n    background-image: url(../../public/images/three-dots-vertical.svg);\n    background-size: 50%;\n    background-repeat: no-repeat;\n    background-position: center;\n    position: absolute;\n    background-color: #2a202d;\n    border: none;\n    border-radius: 50%;\n    width: 36px;\n    height: 36px;\n    top: 10px;\n    right: 10px;\n}\n.btn-roulette {\n    width: 100%;\n    padding: 15px;\n    background-color: var(--dark-gray);\n    border: none;\n}\n.btn-close-modal {\n    background-image: url(../../public/images/close.svg);\n    background-size: 50%;\n    background-repeat: no-repeat;\n    background-position: center;\n    width: 3rem;\n    height: 3rem;\n    background-color: transparent;\n    border: none;\n    margin-left: auto;\n    cursor: pointer;\n}\n.arrow-button {\n    width: 40px;\n    height: 40px;\n    background-image: url(\"../../public/images/arrow-down.svg\");\n    background-size: 20px 20px;\n    background-repeat: no-repeat;\n    background-position: center;\n    background-color: transparent;\n    border: none;\n    cursor: pointer;\n    transition: transform 0.3s ease;\n}\n.arrow-button.open {\n    transform: rotate(180deg);\n}\n/* add movie container */\n.add-movie__form-container {\n    display: flex;\n    flex-direction: column;\n    width: 976px;\n    background-color: var(--black);\n    padding: 40px;\n}\n.add-movie__form-container h2 {\n    color: var(--white);\n    text-transform: uppercase;\n    font-size: 40px;\n    font-weight: 300;\n    margin-bottom: 30px;\n}\n.add-movie__form label {\n    color: var(--red);\n    text-transform: uppercase;\n    font-size: 16px;\n    font-weight: 500;\n    letter-spacing: 0.9px;\n    margin-bottom: 8px;\n}\n.add-movie__form input {\n    margin-bottom: 15px;\n    color: var(--white);\n}\n.add-movie__form-textrea {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n}\n.add-movie__form-textrea textarea {\n    height: 150px;\n    color: var(--white);\n}\n.add-movie__form select {\n    appearance: none;\n    background: url(\"../../public/images/arrow-down.svg\") no-repeat right 20px center;\n    background-size: 1.5rem;\n    background-size: 1.5rem;\n    padding-right: 3rem;\n    color: var(--white);\n}\n.add-movie__form input,\n.add-movie__form select,\n.add-movie__form textarea {\n    background-color: var(--dark-gray);\n    border: none;\n    padding: 10px;\n    font-family: inherit;\n    border-radius: 5px;\n    outline: 0;\n}\n.add-movie__form input:focus,\n.add-movie__form select:focus,\n.add-movie__form textarea:focus {\n    border: 1px solid #f65261;\n}\n.genre-dropdown_toggle {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    background-color: var(--dark-gray);\n    border-radius: 5px;\n}\n.genre-dropdown_toggle span {\n    color: var(--white);\n    padding: 10px;\n}\n.dropdown-options {\n    display: flex;\n    flex-direction: column;\n    background-color: var(--black);\n    border-radius: 3px;\n    max-width: 100%;\n}\n.dropdown-options label {\n    display: flex;\n    gap: 10px;\n    color: var(--white);\n}\ninput[type=\"checkbox\"] {\n    accent-color: var(--red);\n}\n.dropdown-options label input[type=\"checkbox\"] {\n    margin: 0;\n    align-self: center;\n}\ninput[type=\"date\"] {\n    color: hsla(0, 0%, 100%, 0.2);\n}\ninput[type=\"date\"]::-webkit-calendar-picker-indicator {\n    filter: invert(24%) sepia(96%) saturate(7471%) hue-rotate(345deg)\n    brightness(95%) contrast(115%);\n}\n.add-movie__form-fields {\n    display: flex;\n    gap: 1rem;\n}\n.add-movie__form-buttons {\n    display: flex;\n    gap: 10px;\n    margin-top: 30px;\n    justify-content: flex-end;\n}\n.txt-inputs,\n.num-inputs {\n    display: flex;\n    flex-direction: column;\n}\n.txt-inputs {\n    flex: 0 0 59%;\n}\n\n.num-inputs {\n    flex: 0 0 39%;\n}\n.warning-message {\n    color: var(--red);\n    font-size: 14px;\n    margin-bottom: 20px;\n}\n.hidden {\n    display: none;\n}\n/* Success modal window */\n.success-window__modal {\n    background-color: var(--black);\n    color: var(--white);\n    display: flex;\n    text-align: center;\n    flex-direction: column;\n    width: 600px;\n    height: 300px;\n}\n.success-icon {\n    width: 50px;\n    height: 50px;\n    border-radius: 50%;\n    background-color: var(--red);\n    background-image: url(../../public/images/success.svg);\n    background-repeat: no-repeat;\n    background-position: center;\n    background-size: 2rem;\n    margin: 0 auto 30px;\n}\n.success-window__header {\n    text-transform: uppercase;\n    font-weight: 300;\n    font-size: 40px;\n    letter-spacing: 1px;\n    margin-bottom: 30px;\n}\n.success-window__message {\n    font-size: 20px;\n    font-weight: 400;\n    width: 300px;\n    margin: 0 auto;\n}\n/* modal */\n.modal {\n    z-index: 100;\n    border: none;\n    margin: auto;\n}\n.modal::backdrop {\n    background-color: rgba(0, 0, 0, 0.7);\n    backdrop-filter: blur(3px);\n}\n/* search result single movie deets */\n.selected-movie {\n    /* border: 3px solid green; */\n    padding: 20px;\n}\n.selected-movie__header {\n    /* border: 1px solid orange; */\n    display: flex;\n    align-items: center;\n    color: var(--red);\n    margin-bottom: 20px;\n}\n.selected-movie__content {\n    /* border: 1px solid pink; */\n    display: flex;\n    gap: 40px;\n}\n.selected-movie__poster {\n    /* border: 4px solid red; */\n    max-width: 380px;\n    height: 485px;\n    flex: 0 0 30%;\n}\n.selected-movie__poster img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n}\n.selected-movie__info {\n    /* border: 2px solid blue; */\n    flex: 1;\n}\n.selected-movie__title-rating {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    font-weight: 300;\n}\n.selected-movie__title {\n    font-size: 40px;\n    letter-spacing: 1px;\n}\n.selected-movie__rating {\n    border: 1px solid var(--white);\n    border-radius: 50%;\n    width: 48px;\n    height: 48px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    font-size: 20px;\n}\n.selected-movie__genre {\n    font-size: 14px;\n    font-weight: 500;\n    opacity: 0.5;\n}\n.selected-movie__meta {\n    color: var(--red);\n    font-weight: 300;\n    font-size: 24px;\n    display: flex;\n    gap: 50px;\n    margin: 20px 0;\n}\n.selected-movie__description {\n    font-weight: 300;\n    font-size: 20px;\n    opacity: 0.5;\n}\n
